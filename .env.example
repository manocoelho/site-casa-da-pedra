# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis no Vercel
# (Project Settings → Environment Variables).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Publishable key (sb_publishable_...). A chave "anon" legada também funciona.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# URL pública do site (usada fora do browser). Ex.: https://casadapedra.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
