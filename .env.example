# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis no Vercel
# (Project Settings → Environment Variables).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Publishable key (sb_publishable_...). A chave "anon" legada também funciona.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# URL pública do site (usada fora do browser). Ex.: https://casadapedra.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave administrativa do Supabase (necessária para Webhooks de pagamento em segundo plano)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Mercado Pago (Credenciais de Produção ou Teste)
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx

